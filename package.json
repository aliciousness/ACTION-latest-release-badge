{
  "name": "latest-release-badge",
  "version": "1.0.1",
  "description": "A github Action that takes the repo name and owner and returns the latest release badge",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint **.js",
    "update-readme": "node action-docs/update-readme.js && action-docs --update-readme",
    "build": "ncc build index.js -o dist",
    "prebuild": "pnpm run lint && pnpm run update-readme"
  },
  "author": "Richard Craddock",
  "license": "ISC",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "axios": "^1.16.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "^0.38.4",
    "action-docs": "^2.5.1",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^6.1.1"
  },
  "packageManager": "pnpm@10.33.0",
  "volta": {
    "node": "24"
  }
}
